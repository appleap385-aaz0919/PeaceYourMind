# 배치 산출물 — gh-pages에 배포되므로 저장소에 커밋하지 않는다 (FYM 승계)
dist/

# Actions에서 직전 배포본을 체크아웃하는 경로
_previous/

# 부분 실행(--only) 산출물 — 주제가 다 들어 있지 않아 배포 대상이 아니다.
*.partial.json

# 후보 검토 시트 — suggest_channels.py가 매번 새로 만드는 일회성 작업 문서.
# 승인 결과는 channel_allowlist.yaml에 남으므로 이 파일 자체는 이력이 필요 없다.
#
# 파일명에 타임스탬프가 붙는다(channel_candidates.20260818-064420.md).
# 드라이런이 실제 결과를 덮어쓴 FYM 사고를 막기 위한 것이라, 와일드카드로 받는다.
# `channel_candidates.md`만 적으면 실제 산출물이 전부 추적 대상이 된다.
channel_candidates*.md

# 제목 덤프 (build_videos.py --dump-titles) — 태깅 전략 분석용 원자료.
# 매 실행 바뀌고 배포에 나가지 않으며, 커밋하면 매번 워킹트리를 더럽힌다.
# dist/ 안에 떨어지면 이미 무시되지만, --out-dir를 바꿔 쓰는 경우까지 받는다.
titles*.json

# 로컬 환경변수 (YOUTUBE_API_KEY 등)
# 운영 키는 GitHub Actions Secrets에만 두고, 저장소에는 어떤 형태로도 넣지 않는다.
# PYM은 FYM과 API 키를 분리한다 (PLAN.md 6절) — 두 저장소의 .env를 섞지 않는다.
.env
.env.*
!.env.example

# 일일 쿼터 소모 기록 (Phase 2에서 이식)
# 기기마다 값이 다르고 매 실행마다 바뀐다. 커밋하면 워킹트리가 계속 더러워진다.
.quota_log.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# --- 앱 (Phase 3) ---
node_modules/
app/dist/

# 앱(Capacitor) 번들. dist와 **반드시 갈라 둔다** —
# deploy-app.yml이 app/dist를 웹에 올리므로 같은 자리에 쓰면
# 앱 번들이 웹으로 배포될 수 있다 (vite.config.js 주석).
app/dist-app/

# themes.yaml에서 빌드 때마다 생성한다.
# 사본을 커밋하면 원본과 반드시 어긋난다 — 단일 소스를 지킨다.
app/src/data/themes.json
app/src/data/taxonomy.json

# verses.yaml에서 생성한다 (gen_verses_json.py, Phase 2).
# note 등 큐레이션 메타가 제거된 파생물이라 소스가 아니다.
app/src/data/verses.json

# data/krv/ 원문에서 잘라낸 장 파일 174개 (gen_krv_chapters.py, "이어서 읽기").
# 원문 전체가 이미 커밋돼 있으므로 이것은 순수한 파생물이다.
# 커밋하면 174개 파일이 diff에 섞여 큐레이션 변경을 가린다.
app/public/krv/

# --- 커밋하는 것 (무시하지 않는다) ---
#
# data/krv/  개역한글 원문. 저작재산권 보호기간 만료로 자유 사용 가능하며
#            (verses.yaml 헤더 참조), 구절 본문 대조의 기준이 된다.
#            이 파일이 바뀌면 모든 verified 판정의 근거가 바뀌므로
#            버전 관리 대상이다. 무결성은 data/krv/SOURCE.md의 sha256으로 확인한다.

# AdMob App ID — 값은 저장소에 두지 않는다 (app/android/admob.properties.example 참조).
#   ⚠⚠ 없거나 틀리면 앱이 시작하자마자 죽는 값이라 빌드가 서게 해 두었다.
#   ⛔ **무늬로 막는다 — 사본까지 막아야 한다** (2026-09-03 · HANDOFF 2.117).
#     정확한 경로 하나만 막아 두었더니 admob.properties.bak / .local / .save 같은
#     사본이 추적 대상이 됐다. 세션이 작업 중에 실제로 .bak을 만들었고,
#     **사람이 만들면 조용히 커밋된다 — 경보가 없다.**
#     이 파일에는 실제 광고 단위 ID와 기기 광고 ID(AAID)가 들어 있다.
app/android/admob.properties*
#   ⚠ .example 은 값이 없는 견본이라 **추적해야 한다** — 위 무늬에서 되살린다.
!app/android/admob.properties.example
